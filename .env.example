# Параметры docker compose: скопировать в .env и при необходимости изменить (.env в репозиторий не попадает)

# Брокер RabbitMQ (пользователь guest из других контейнеров подключаться не может)
RABBITMQ_USER=transit
RABBITMQ_PASSWORD=transit
RABBITMQ_AMQP_PORT=5672
RABBITMQ_UI_PORT=15672

# PostgreSQL
POSTGRES_USER=transit
POSTGRES_PASSWORD=transit
POSTGRES_DB=transit
POSTGRES_HOST_PORT=5433

# Порты на хосте
GATEWAY_PORT=8080
API_PORT=8081

# Обработчики (common/reliability.py, ЛР 3)
PREFETCH=50
PROCESS_DELAY_MS=0
DB_TIMEOUT_S=10
MAX_ATTEMPTS=4
RETRY_DELAYS_MS=5000,30000,120000
FAULT_RATE=0
HEADWAY_MIN=3
